42:["$","$L3d","Where can I see more detailed metrics for a model?-8",{"value":"item-8","children":[["$","$L3e",null,{"className":"text-left font-medium text-base border-b pb-2 mb-4 hover:no-underline","children":"Where can I see more detailed metrics for a model?"}],["$","$L3f",null,{"children":["$","p",null,{"className":"text-neutral-700","children":["Click on any model name in the leaderboard to visit its dedicated comparison page with detailed charts covering intelligence, pricing, speed, latency, and more. You can also compare API providers for each model.",[" ",["$","$Lb",null,{"href":"/models","className":"underline hover:text-foreground","children":"View all models"}]]]}]}]]}]
44:Tb23,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Which AI model ranks #1 on the LLM Leaderboard?","acceptedAnswer":{"@type":"Answer","text":"Claude Opus 5.5 (Max, Default Fallback) currently ranks #1 on the Artificial Analysis LLM Leaderboard with an Intelligence Index score of 58, out of 127 models ranked."}},{"@type":"Question","name":"What are the top models on the LLM Leaderboard?","acceptedAnswer":{"@type":"Answer","text":"The top models by Intelligence Index are: 1. Claude Opus 5.5 (Max, Default Fallback) (58), 2. Claude Sonnet 5.5 (Max, Default Fallback) (56), 3. Claude Opus 5.5 (Xhigh, Default Fallback) (56), 4. Muse Wonder Full (Max) (56), 5. Claude Opus 5.5 (High, Default Fallback) (54)."}},{"@type":"Question","name":"Which AI model has the fastest output speed?","acceptedAnswer":{"@type":"Answer","text":"Celeris-1 is the fastest at 1,549.2 tokens per second, followed by Mercury 2.5 (761.8 t/s) and Gemini 3.5 Flash-Lite (407.6 t/s)."}},{"@type":"Question","name":"Which AI model is the most affordable?","acceptedAnswer":{"@type":"Answer","text":"K2 Horizon 375B A23B has the lowest cost per Intelligence Index task at $0.00, followed by Gemma 4 31B (Reasoning) ($0.00) and Command A+ ($0.00)."}},{"@type":"Question","name":"Which is the best open weights model on the leaderboard?","acceptedAnswer":{"@type":"Answer","text":"MiMo-V2.6-Pro is the highest-ranked open weights model with an Intelligence Index score of 46. There are 59 open weights models out of 127 total on the leaderboard."}},{"@type":"Question","name":"What are the top open weights models on the leaderboard?","acceptedAnswer":{"@type":"Answer","text":"The top open weights models by Intelligence Index are: 1. MiMo-V2.6-Pro (46), 2. GLM-5.3 (Max) (45), 3. Kimi K3 (Max) (44)."}},{"@type":"Question","name":"Which is the best reasoning model on the leaderboard?","acceptedAnswer":{"@type":"Answer","text":"Claude Opus 5.5 (Max, Default Fallback) leads among 117 reasoning models with an Intelligence Index score of 58. Reasoning models use extended thinking to solve complex problems before responding."}},{"@type":"Question","name":"How do I filter models on the leaderboard?","acceptedAnswer":{"@type":"Answer","text":"The leaderboard includes filters to narrow results by model type (reasoning vs non-reasoning), openness (open weights vs proprietary), and other criteria. You can also adjust prompt options to see how performance varies with different input lengths."}},{"@type":"Question","name":"Where can I see more detailed metrics for a model?","acceptedAnswer":{"@type":"Answer","text":"Click on any model name in the leaderboard to visit its dedicated comparison page with detailed charts covering intelligence, pricing, speed, latency, and more. You can also compare API providers for each model."}}]}43:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$44"}}]
