25:["$","$L27",null,{"composition":{"sections":[{"default":true,"anchor":{"id":"#personality-indexes"},"title":"Personality Indexes","content":["$","$L28",null,{"selector":["$","$L29",null,{"placeholderTotalCount":41}],"locale":"en","messages":{"indexes":{"expressiveness":{"label":"Expressiveness","description":"Rich, varied, well-crafted language"},"organization":{"label":"Organization","description":"Well-structured, scannable, answer-first"},"informativeness":{"label":"Informativeness","description":"Practical depth, evidence, actionable content"},"transparency":{"label":"Transparency","description":"Truthful, acknowledges uncertainty, non-sycophantic"},"warmth":{"label":"Warmth","description":"Friendly, humorous, sincere, emotionally attuned"},"conviction":{"label":"Conviction","description":"Direct, confident positions and constructive pushback"},"imagination":{"label":"Imagination","description":"Creative, exploratory, open-ended thinking"},"slop":{"label":"Slop","description":"Use of filler and generic language"}},"charts":{"indexRadar":{"title":"Personality Indexes","subtitle":"Each axis is one of 8 personality indexes: the mean of its traits’ Elo z-scores, percentile ranked from 1 to 100 across all models evaluated in the benchmark","ariaLabel":"Personality index radar chart","empty":"No selected models have personality index results yet","tooltipValue":"{value} / 100","tooltipInterval":"95% CI {lower} to {upper}","download":{"model":"Model","creator":"Creator","slug":"Slug","lower":"{index} Lower Bound (95% CI)","upper":"{index} Upper Bound (95% CI)","detailsUrl":"Details URL"}},"winProbability":{"title":"AA-PersonalityBench: Model Personality Comparison","chartTitle":"AA-PersonalityBench: {index} Index, {modelA} vs {modelB}","subtitle":{"chance":"Chance each model’s answer is judged to show more of each trait from their Elo gap","evenMatch":"50% is an even match"},"modelA":"Model A","modelB":"Model B","versus":"vs","placeholder":"Not available","searchPlaceholder":"Search models...","noModels":"No models found","barAriaLabel":"{trait}: {probabilityA} {modelA}, {probabilityB} {modelB}","tooltipWinProbability":"Win probability: {probabilityA} {modelA}, {probabilityB} {modelB}","tooltipElo":"Elo {eloA} ({modelA}) vs {eloB} ({modelB})","download":{"trait":"Trait","elo":"{model} Elo","winProbability":"{model} Win Probability (%)"}},"fingerprints":{"personality":{"title":"Model Fingerprints: Personality Traits","subtitle":{"signals":"The five judged traits where each model sits furthest above and below the average across all models evaluated in the benchmark","units":"Standard deviations (σ) of trait Elo"},"missing":"No judged trait results yet for {models}. See the Communication Characteristics tab."},"communication":{"title":"Model Fingerprints: Communication Characteristics","subtitle":{"signals":"The five measured metrics each model uses most and least compared with the average across all models evaluated in the benchmark","units":"Standard deviations (σ) of the average per response"},"missing":"No communication results yet for {models}."},"empty":"No results for the selected models yet","tooFewModels":"Fingerprints need results for at least two models","mostAbove":"Most above average","mostBelow":"Most below average","download":{"model":"Model","shortName":"Short Name","slug":"Slug","sigma":"{signal} (σ)"}}}}}],"description":"Each index takes the mean of its traits’ Elo z-scores, then percentile ranks it from 1 to 100 across all models evaluated in the benchmark.","headerAction":"$undefined","href":"$undefined","change":"$undefined"},{"default":true,"anchor":{"id":"#how-traits-form-personality-indexes"},"title":"How Traits Form Personality Indexes","content":["$","div",null,{"className":"flex flex-col gap-4","children":[["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3","children":["$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31"]}],"$L32"]}],"description":"30 questions per personality trait (900 questions total), judged by a panel of models. Each index z-scores its traits’ Elo ratings, inverts traits where needed, calculates the mean, and percentile ranks the result from 1 to 100 across all models evaluated in the benchmark.","headerAction":"$undefined","href":"$undefined","change":"$undefined"},{"default":true,"anchor":{"id":"#example-tasks"},"title":"Example Questions, Responses, and Grading","content":"$L33","description":"$undefined","headerAction":"$undefined","href":"$undefined","change":"$undefined"},{"default":true,"anchor":{"id":"#detailed-personality-trait-results"},"title":"Detailed Personality Trait Results","content":"$L34","description":"All 30 judged personality traits which comprise the 8 indexes.","headerAction":"$undefined","href":"$undefined","change":"$undefined"},{"default":true,"anchor":{"id":"#personality-trait-leaderboards"},"title":"Personality Trait Leaderboards","content":"$L35","description":"Each trait’s Elo percentile ranked from 1 to 100 across all models evaluated in the benchmark. Overall tabs show the index: the mean of its traits’ Elo z-scores, percentile ranked the same way. Whiskers show each model’s 95% confidence interval on the same scale.","headerAction":"$undefined","href":"$undefined","change":"$undefined"},{"default":true,"anchor":{"id":"#compare-model-personalities"},"title":"Compare Model Personalities","content":"$L36","description":"Compare any two models: each bar shows the probability one model’s answer is judged to show more of that trait, based on their Elos.","headerAction":"$undefined","href":"$undefined","change":"$undefined"},{"default":true,"anchor":{"id":"#emergent-model-families-and-clusters"},"title":"Emergent Model Families & Clusters","content":"$L37","description":"Models grouped by how alike their judged traits and communication characteristics are, using average-linkage clustering on the correlation between z-scores.","headerAction":"$undefined","href":"$undefined","change":"$undefined"},{"default":true,"anchor":{"id":"#build-your-own-personality"},"title":"Build Your Own Personality Ranking","content":"$L38","description":"Pick any of the 30 traits and weight them from −2 to +2. Your traits’ Elo z-scores are combined as a weighted mean, then percentile ranked from 1 to 100 across all models evaluated in the benchmark.","headerAction":"$undefined","href":"$undefined","change":"$undefined"},{"default":true,"anchor":{"id":"#communication-characteristics"},"title":"Communication Characteristics","content":"$L39","description":"21 metrics measured directly from each response, separate from the judged traits above. Cells show the average per response, colored by its percentile rank across all models evaluated in the benchmark.","headerAction":"$undefined","href":"$undefined","change":"$undefined"},{"default":true,"anchor":{"id":"#model-fingerprints"},"title":"Model Fingerprints","content":"$L3a","description":"Each model’s strongest and weakest signals, as standard deviations (σ) above (+) or below (−) the average across models.","headerAction":"$undefined","href":"$undefined","change":"$undefined"}],"menuItems":[{"anchor":"$25:props:composition:sections:0:anchor","label":"Personality Indexes","change":"$undefined"},{"anchor":"$25:props:composition:sections:1:anchor","label":"How Traits Form Personality Indexes","change":"$undefined"},{"anchor":"$25:props:composition:sections:2:anchor","label":"Example Questions, Responses, and Grading","change":"$undefined"},{"anchor":"$25:props:composition:sections:3:anchor","label":"Detailed Personality Trait Results","change":"$undefined"},{"anchor":"$25:props:composition:sections:4:anchor","label":"Personality Trait Leaderboards","change":"$undefined"},{"anchor":"$25:props:composition:sections:5:anchor","label":"Compare Model Personalities","change":"$undefined"},{"anchor":"$25:props:composition:sections:6:anchor","label":"Emergent Model Families & Clusters","change":"$undefined"},{"anchor":"$25:props