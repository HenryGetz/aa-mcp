f:["$","div",null,{"className":"bg-background","children":[["$","section",null,{"className":"bg-brand-blue-light pt-32 pb-16","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"grid grid-cols-1 gap-4 mb-12 lg:grid-cols-12","children":[["$","div",null,{"className":"lg:col-span-6","children":[["$","p",null,{"className":"mb-2 text-xs text-neutral-600","children":["$","$Lc",null,{"href":"/evaluations","className":"inline-flex items-center gap-1 text-neutral-600 hover:text-neutral-900","children":[["$","$L1b",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":12}],"All evaluations"]}]}],["$","div",null,{"className":"flex flex-wrap items-center gap-3 mb-4","children":[["$","h1",null,{"className":"text-4xl max-w-[27ch] 2xl:max-w-none","children":"AA-PersonalityBench: AI Personality & Communication Style Benchmark"}],false]}],["$","div",null,{"className":"flex flex-wrap gap-1 items-center mb-4","children":[[["$","$Lc","attribute-private-dataset",{"href":"/evaluations?attribute=private-dataset","className":"inline-flex items-center rounded-full leading-none whitespace-nowrap border bg-white border-neutral-200 text-xs px-3 py-1.5 transition-colors hover:bg-neutral-100","children":"Private Dataset"}]],[["$","$Lc","skill-writing",{"href":"/evaluations?skill=writing","className":"inline-flex items-center rounded-full leading-none whitespace-nowrap border bg-white border-neutral-200 text-xs px-3 py-1.5 transition-colors hover:bg-neutral-100","children":"Writing"}],["$","$Lc","skill-personality",{"href":"/evaluations?skill=personality","className":"inline-flex items-center rounded-full leading-none whitespace-nowrap border bg-white border-neutral-200 text-xs px-3 py-1.5 transition-colors hover:bg-neutral-100","children":"Personality"}]],[]]}],["$","div",null,{"className":"text-sm max-w-[60ch] space-y-4 [&_a]:underline [&_a:hover]:text-brand-purple [&_a]:transition-colors mb-4","children":"Measures how models communicate rather than whether they are correct: 30 judged personality traits rolled up into 8 indexes, plus 21 measured communication characteristics."}],["$","$Lc",null,{"href":"#example-tasks","className":"inline-flex items-center gap-1.5 text-sm text-neutral-600 hover:text-neutral-900 mb-10","children":["See example tasks",["$","$L1b",null,{"ref":"$undefined","iconNode":[["path",{"d":"M12 5v14","key":"s699le"}],["path",{"d":"m19 12-7 7-7-7","key":"1idqje"}]],"className":"lucide-arrow-down","size":14}]]}],["$","$L1c",null,{"type":"single","collapsible":true,"defaultValue":"background","children":["$","$L1d",null,{"value":"background","children":[["$","$L1e",null,{"className":"text-base text-left border-b pb-2 mb-2 hover:no-underline","children":"Background"}],["$","$L1f",null,{"className":"pt-2 text-sm space-y-2 text-black","children":[["$","div","0",{"children":"AA-PersonalityBench measures how AI models differ in personality and communication style. It is not a capability benchmark: scores describe how a model tends to write and respond, not whether it is correct."}],["$","div","1",{"children":"30 personality traits are judged pairwise: a panel of LLM judges compares two answers to the same prompt and picks the one that shows more of the trait, whether or not the trait is desirable. Verdicts become a Bradley-Terry Elo rating per trait, over 30 prompts written for each trait (900 in total)."}],["$","div","2",{"children":"The 30 traits roll up into 8 personality indexes: Expressiveness, Organization, Informativeness, Transparency, Warmth, Conviction, Imagination, and Slop. Each index is the mean of its traits’ Elo z-scores, percentile ranked from 1 to 100 across every model evaluated in the benchmark."}],["$","div","3",{"children":"Alongside the judged traits, 21 communication characteristics (length, structure, punctuation and emphasis) are measured directly from every response."}]]}]]}]}],"$L20"]}],"$L21"]}],"$undefined","$undefined"]}]}],"$L22"]}]
